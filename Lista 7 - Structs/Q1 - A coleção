#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

// Struct que armazena os dados de cada jogo da colecao
typedef struct {
    char *titulo_jogo;
    char *genero_jogo;
    char *estudio_jogo;
    char *console_jogo;
    int nota_jogo;
    int ano_jogo;
} Jogo;

//Definindo um typedef que aponta para funcoes de busca e impressao
typedef void (*Comando_Ptr)(Jogo **, int, char *);

//Compara duas strings
int strings_iguais(char *str_a, char *str_b) {
    // loop para percorre ambos os ponteiros ate encontrar o fim de um deles
    while (*str_a != '\0' && *str_b != '\0') {
        if (*str_a != *str_b) {
            return 1; //Return 1 se encontrar caracteres diferentes
        }
        str_a++;
        str_b++;
    }
    //Se ambos terminarem juntos -- as strings sao identicas
    return (*str_a == *str_b) ? 0 : 1;
}

//Convercao deuma string numerica para inteiro sem funcoes prontas
int texto_inteiro(char *str_num) {
    int valor_final = 0;
    while (*str_num >= '0' && *str_num <= '9') {
        //Deslocacao da casa decimal e soma o novo digito
        valor_final = (valor_final * 10) + (*str_num - '0');
        str_num++;
    }
    return valor_final;
}

// funcao para printar os jogos de um ano especifico
void busca_ano(Jogo **lista_jogos, int total_n, char *param_busca) {
    int ano_alvo = texto_inteiro(param_busca);
    int cont_jogos = 0;
    int indice_i = 0;
    while (indice_i < total_n) {
        //brusca o membro ano_jogo da struct apontada na matriz
        if ((*(*(lista_jogos + indice_i))).ano_jogo == ano_alvo) {
            printf("%s\n", (*(*(lista_jogos + indice_i))).titulo_jogo);
            cont_jogos++;
        }
        indice_i++;
    }
    if (cont_jogos > 0) printf("Tenho %d jogos || %s.\n", cont_jogos, param_busca);
    else printf("Nenhum jogo tem esse parâmetro Sr Sr Wilson.\n");
}

